# Local overrides. No secrets belong in this file or in any committed environment file.
ATLAS_PROFILE=default
ATLAS_REGION=iran
ATLAS_API_HOST=127.0.0.1
ATLAS_API_PORT=3000
ATLAS_GATEWAY_ORIGIN=http://localhost:8080
ATLAS_DATA_ROOT=./data
ATLAS_ACTIVE_SNAPSHOT_PATH=./data/active.json
ATLAS_LOG_LEVEL=info
ATLAS_UPDATE_MODE=disabled
ATLAS_OFFLINE=true
ATLAS_UPDATER_HOST=127.0.0.1
ATLAS_UPDATER_PORT=3001

# Basemap domain configuration, used when provisioning a dataset.
ATLAS_FONT_PATH=./assets/fonts/Vazirmatn-Regular.ttf
# ATLAS_REGION_CONFIG_PATH=./config/regions/iran.yaml

# Provisioning tooling. Read only inside the platform package: no application and no part of the
# core layer interprets these, and no command-line flag selects a tool.
#   ATLAS_TILE_TOOL_KIND    external (default, consumes operator-supplied inputs) | synthetic
#   ATLAS_TILE_TOOL_MODE    container (default) | jar
#   ATLAS_TILE_TOOL_ARCHIVE path to a local tool archive, used only in jar mode
# ATLAS_TILE_TOOL_KIND=external
# ATLAS_TILE_TOOL_MODE=container
# ATLAS_TILE_TOOL_ARCHIVE=/opt/tools/tiler.jar

# Search tooling. Read only inside the platform package, like the tile tooling.
#   ATLAS_SEARCH_TOOL_KIND  follows the tile tool (default) | external | synthetic | none
#   ATLAS_SEARCH_TOOL_MODE  container (default) | local
#   ATLAS_SEARCH_TOOL_MEMORY_LIMIT  hard memory limit per provisioning container, default 4g
#   ATLAS_SEARCH_TOOL_PIDS_LIMIT    process and thread limit per provisioning container, default 4096
# ATLAS_SEARCH_TOOL_KIND=none
# ATLAS_SEARCH_TOOL_MODE=container

# Private search hosts the API consults, one per slot. Unset means that slot has no search host.
# ATLAS_SEARCH_ENGINE_BLUE_URL=http://127.0.0.1:2322
# ATLAS_SEARCH_ENGINE_GREEN_URL=http://127.0.0.1:2323

# Hard limits for each search host container in Compose. Bounds, not sizes: set them, and the
# engine heap below them, from a measured run of your own data.
# ATLAS_SEARCH_HOST_MEMORY_LIMIT=2g
# ATLAS_SEARCH_HOST_PIDS_LIMIT=1024
